{
  "crons": [
    { "path": "/api/backup", "schedule": "0 13 * * *" }
  ],
  "functions": {
    "api/backup.js": { "maxDuration": 60 },
    "api/clear.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
